{
  "name": "selenium2playwright-samples",
  "private": true,
  "license": "MIT",
  "description": "Realistic Selenium WebDriver (TS) samples \u2014 demo inputs and eval fixtures for the conversion agent",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "mocha --require tsx/cjs 'selenium-suite/tests/**/*.spec.ts'",
    "test:hard": "mocha --require tsx/cjs 'selenium-hard-suite/tests/**/*.spec.ts'",
    "test:golden": "playwright test",
    "test:hard-golden": "playwright test --config playwright.hard.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^26.6.4",
    "@types/selenium-webdriver": "^4.35.7",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.50.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
