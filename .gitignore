# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — API keys live here, never in the repo
.env
.env.*
!.env.example

# Node toolchain (samples + validation sandbox, Phase 1+)
node_modules/
test-results/
playwright-report/

# Local working docs — build-sequence notes, not part of the public face
roadmap.md
plan-review.md

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Generated conversions (scratch output of the converter, never source of truth)
out/

# Thread databases (step 7.1) — checkpointed conversations: your source, every
# draft, and your standing instructions. Working data, not repository content.
.s2p/

# `langgraph dev` state (step 10.1) — the local server's own checkpointer,
# store and vectors, written next to the config it started from.
.langgraph_api/

# Fly deployment (step 10.2) — the generated Dockerfile is derived from
# langgraph.json on every deploy, and .pgpassword is the database password that
# builds POSTGRES_URI. Fly's secret store is where it actually lives; this file
# is the local copy needed to reassemble the URI, and is a secret like any other.
deploy/fly/Dockerfile.generated
deploy/fly/.pgpassword
