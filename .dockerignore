# What the deployment image does NOT need (step 10.2). Docker reads this, not
# .gitignore, so anything left out here would otherwise be baked into a layer.

# Secrets. Never in an image: the deployment gets its keys as environment
# variables, set on the deployment, not shipped inside it.
.env
.env.*
!.env.example

# The database password's local copy (deploy.sh writes it; Fly's secret store
# holds the real one). The API image is `ADD .` of the whole repository, so a
# file .gitignore keeps off GitHub is still baked in here unless it is listed
# again: it was, until 2026-09-12. Same for local agent settings, which can
# carry pasted commands.
deploy/fly/.pgpassword
.claude/settings.local.json
roadmap.md
plan-review.md

.git
.venv
__pycache__/
*.py[oc]
*.egg-info

# Node dependencies are INSTALLED in the image from the lockfile, on Linux.
# Copying a macOS tree in would shadow that with the wrong platform's binaries.
node_modules/
sandbox/work/

# Local working state and scratch output — none of it is input to a conversion.
out/
.s2p/
.langgraph_api/
test-results/
playwright-report/
.DS_Store
.idea/
.vscode/

# The built page is produced inside the image (Dockerfile.ui, Node stage);
# a local build must not shadow it.
ui/web/dist/
