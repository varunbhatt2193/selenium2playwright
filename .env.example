# Copy this file to .env and fill in the values.
# .env is gitignored — secrets never reach the repo.
# A variable already exported in your shell wins over this file.

# console.anthropic.com -> API Keys -> Create Key   (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Only needed for identity-linked API keys: the workspace requests act in.
# console.anthropic.com -> Settings -> Workspaces -> copy the ID (starts with wrkspc_)
# This is an identifier, not a secret — but it lives here with its key.
ANTHROPIC_WORKSPACE_ID=

# smith.langchain.com -> Settings -> API Keys -> Create API Key
# (starts with lsv2_; the free Developer plan is fine)
LANGSMITH_API_KEY=

# Which chat model to use, in LangChain init_chat_model "provider:model" form.
# Defaults to anthropic:claude-sonnet-5; `s2p convert --model <name>` overrides
# it for one run. Any provider works once its LangChain package is installed
# (uv add langchain-google-genai / langchain-groq / langchain-mistralai ...) and
# its key is set. s2p already knows the key variable for anthropic, openai,
# azure_openai, google_genai, groq, mistralai, deepseek, xai, together,
# fireworks, cohere, openrouter, perplexity and voyage (see env.py
# PROVIDER_KEYS), and simply lets any other provider check its own credentials.
S2P_MODEL=

# Optional: a different model for the critic (the reviewer). Same
# "provider:model" form. Empty means "same as S2P_MODEL". Used by the
# weak-actor / strong-critic evaluation (docs/reflection-haiku-ab.md).
S2P_CRITIC_MODEL=

# Which embeddings model ranks your remembered preferences against the file
# being converted (step 7.3). Same "provider:model" form; empty means the
# default, openai:text-embedding-3-small (needs OPENAI_API_KEY). Alternatives:
# voyage:voyage-3.5-lite (uv add langchain-voyageai, VOYAGE_API_KEY).
# Set it to "off" to keep long-term memory without semantic search: recall then
# falls back to the most recent preferences, and no embeddings key is needed.
# Changing it after memories exist is refused — vectors from two models are not
# comparable (see store.py).
S2P_EMBEDDINGS=

# platform.openai.com -> API keys. Needed by the default embeddings above, and
# by S2P_MODEL / S2P_JUDGE_MODEL if you point either at an OpenAI model.
OPENAI_API_KEY=

# Where the pinned Node toolchain (tsc, ESLint, the two AST scripts) lives.
# Empty means the sandbox/ folder in this repository, which is right on a
# checkout. The deployment image (step 10.2) sets it to /opt/s2p-sandbox,
# because the directory a repo is cloned into is not something an image knows.
S2P_SANDBOX=

# Default --url for scripts/call_deployment.py: where the deployed graph lives.
# Empty means http://127.0.0.1:8123, the port `langgraph up` uses locally.
# A LangSmith Deployment gives you an https URL instead.
LANGGRAPH_DEPLOYMENT_URL=

# ---------------------------------------------------------------------------
# Step 10.4 — the guardrails that make the deployment safe to hand out.
# ---------------------------------------------------------------------------

# The two keys that decide who may call the deployment. deploy/fly/deploy.sh
# generates both into .env if they are missing, so a deployment cannot be born
# without them — `openssl rand -hex 32` is what it uses.
#   S2P_API_KEY   you: every graph, no limits, reads and writes the store
#   S2P_DEMO_KEY  the playground: metered, inline text only, its own memories
# With NEITHER set the server refuses every request rather than serving an open
# one. That is deliberate: an unconfigured deployment that silently ran open is
# the exact failure this step exists to prevent.
S2P_API_KEY=
S2P_DEMO_KEY=

# Set to "off" to disable authentication entirely — local `langgraph dev` only.
# Explicit and opt-in, so it cannot happen by forgetting something.
S2P_AUTH=

# The ceiling that is actually about money, per day, across every visitor.
# Empty means $5.00. It is enforced in runs rather than dollars, because a run
# has to be allowed before the model answers and the price is only known after;
# S2P_COST_PER_RUN (default 0.12, a deliberate overestimate) is the bridge.
# GET /limits shows what is left. Resets at midnight UTC.
S2P_DAILY_BUDGET_USD=
S2P_COST_PER_RUN=

# Per-visitor fairness, so one enthusiast cannot eat the day before anyone else
# arrives. Empty means 3 conversions per 60 seconds and 10 per day.
S2P_BURST_LIMIT=
S2P_BURST_WINDOW=
S2P_DAILY_LIMIT=

# Fraction of the daily budget at which a one-per-day alert fires. Empty means
# 0.8 — a warning on the way up, not a notification as the door shuts.
S2P_ALERT_AT=

# Optional: POST the alert somewhere (Slack incoming webhook, or anything that
# accepts {"text": "..."}). Empty means it is only logged.
S2P_ALERT_WEBHOOK=

# LangSmith dataset that collects inputs a visitor marked wrong, unreviewed and
# with no expected output — the inbox for the eval set, not the eval set.
# Empty means "s2p-feedback-queue".
S2P_FEEDBACK_DATASET=
